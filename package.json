{
  "name": "foodbazarcafe-pos",
  "version": "1.0.0",
  "description": "Offline POS for Food Bazar Cafe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "node scripts/run-vite.js",
    "build": "node scripts/run-vite.js build",
    "start": "node server/index.js",
    "import-menu": "node server/import-menu.js",
    "postinstall": "node server/init-db.js && node scripts/fix-native-bins.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.64.3"
  }
}
